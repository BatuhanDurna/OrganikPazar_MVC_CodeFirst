
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/Areas/ManagerPanel/Assets/ManagerPanelCSS.css" rel="stylesheet" />
    <link href="~/Areas/ManagerPanel/Assets/bootstrap-5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="layout">
        <div class="sidebar">
            <div class="brandbar">
                <a>
                    <img src="~/Images/Logo.png" width="100" />
                </a>
            </div>
            <div class="sidebar_list">
                <h3>Options</h3>
                <ul style="list-style:none">
                    <a href="@Url.Action("Index","Category")">
                    <li>List Category</li>
                    </a>
                    <a href="@Url.Action("Index","Produce")">
                    <li>List Produce</li>
                    </a>
                    <a href="@Url.Action("Index","Brand")">
                    <li>List Brand</li>
                    </a>
                    <a href="@Url.Action("Index","Unit")">
                    <li>List Unit</li>
                    </a>
                    <a href="@Url.Action("Index","User")">
                    <li>List User</li>
                    </a>
                    <a href="@Url.Action("Index","OrderDetails")">
                    <li>List Orders</li>
                    </a>
                    <a href="@Url.Action("ApprovedIndex","OrderDetails")">
                    <li>List Approved Index</li>
                    </a>
                </ul>
            </div>
        </div>
        <div class="content">
            <div class="header">
                <h2>Manager Panel</h2>
            </div>
            <div class="contentPlaceholder">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="~/Areas/ManagerPanel/Assets/bootstrap-5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
