@model IEnumerable<OrganikPazar_Odev.Models.Users>
@{
    ViewBag.Title = "AllIndex";
    Layout = "~/Areas/ManagerPanel/Views/Shared/_Layout.cshtml";
}
<link href="~/Areas/ManagerPanel/Assets/CategoryIndexCss.css" rel="stylesheet" />

<div class="card">
    <div class="card-header">
        <div class="card-title">
            <h2>Deleted User List</h2>
            <a href="@Url.Action("Index", "User")">User View</a>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-responsive-lg" cellpadding="0" cellspacing="0">
            <tr class="col-md-2">
                <th>
                    @Html.DisplayNameFor(model => model.ID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Surname)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Mail)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CreationTime)
                </th>
                <th>Status</th>
                <th>Options</th>
            </tr>
            @foreach (var item in Model)
            {
                <tr style="background-color:indianred">
                    <td>@item.ID</td>
                    <td>@item.Name</td>
                    <td>@item.Surname</td>
                    <td>@item.Mail</td>
                    <td>@item.CreationTime</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <label class="bi bi-check-circle-fill text-success fs-3"></label>
                        }
                        else
                        {
                            <label class="bi bi-x-circle-fill text-danger fs-3"></label>
                        }
                    </td>
                    <td>
                        <a href="@Url.Action("BackUp","User", new {id = item.ID})" style="color:aliceblue" class="bi bi-arrow-counterclockwise fs-3"></a>
                    </td>
                </tr>
            }
        </table>
    </div>
    <div class="card-footer">
        <label>@Model.Count() Adet silinmiş kullanıcı bulunmaktadır</label>
    </div>
</div>

