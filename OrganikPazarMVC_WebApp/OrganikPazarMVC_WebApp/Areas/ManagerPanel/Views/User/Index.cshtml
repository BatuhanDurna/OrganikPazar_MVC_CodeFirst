@model IEnumerable<OrganikPazar_Odev.Models.Users>
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/ManagerPanel/Views/Shared/_Layout.cshtml";
}

<link href="~/Areas/ManagerPanel/Assets/CategoryIndexCss.css" rel="stylesheet" />

<div class="card">
    <div class="card-header">
        <div class="card-title">
            <h2>User List</h2>
            <a href="@Url.Action("AllIndex","User")">Deleted User View</a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered w-100" cellpadding="0" cellspacing="0">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.ID)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Surname)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Mail)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CreationTime)
                    </th>
                    <th>Status</th>
                    <th>Options</th>
                </tr>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ID</td>
                        <td>@item.Name</td>
                        <td>@item.Surname</td>
                        <td>@item.Mail</td>
                        <td>@item.CreationTime</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <label class="bi bi-check-circle-fill text-success fs-3"></label>
                            }
                            else
                            {
                                <label class="bi bi-x-circle-fill text-danger fs-3"></label>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("Edit","User", new {id = item.ID})" style="margin-bottom:5px" class="duzenlebuton tablebutton bi bi-pencil"></a>
                            <a href="@Url.Action("Delete","User", new {id = item.ID})" class="silbuton tablebutton bi bi-trash"></a>
                            @if (item.IsActive == false)
                            {
                                <a href="@Url.Action("BeActive","User", new {id = item.ID})" class="degistiricibuton tablebutton bi bi-eye"></a>
                            }
                            else
                            {
                                <a href="@Url.Action("BePassive","User", new {id = item.ID})" class="degistiricibuton tablebutton bi bi-eye-slash"></a>
                            }
                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>
    <div class="card-footer">
        <label>@Model.Count() Adet kullanıcı bulunmaktadır</label>
    </div>
</div>

