@model OrganikPazarMVC_WebApp.Areas.ManagerPanel.Data.ManagerLoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Authorization Login</title>
    <link href="~/Areas/ManagerPanel/Assets/AuthorizationLoginCSS.css" rel="stylesheet" />
</head>
<body class="card-body">
    <div class="loginCardContainer">
        @using (Html.BeginForm())
        {
            <div class="row">
                <img src="~/Areas/ManagerPanel/Assets/Gif/ManagerGif.gif" width="325"/>
            </div>
            <div class="row">
                @Html.EditorFor(model => model.Mail, new { htmlAttributes = new { @class = "form-control", @placeholder = "Mail adresiniz" } })
                @Html.ValidationMessageFor(model => model.Mail, "", new { @class = "validationMessage" })
            </div>
            <div class="row">
                @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control", @placeholder = "Şifreniz" } })
                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "validationMessage" })
            </div>
            <div class="row">
                <input type="submit" value="Giriş Yap" class="formbutton" />
            </div>
        }
    </div>
</body>
</html>

