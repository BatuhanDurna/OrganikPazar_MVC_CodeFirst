@model IEnumerable<OrganikPazarMVC_WebApp.Models.OrderDetails>
@{
    ViewBag.Title = "ApprovedIndex";
    Layout = "~/Areas/ManagerPanel/Views/Shared/_Layout.cshtml";
}

<link href="~/Areas/ManagerPanel/Assets/CategoryIndexCss.css" rel="stylesheet" />

<div class="card">
    <div class="card-header">
        <div class="card-title">
            <h2>Approved Orders</h2>
            <a href="@Url.Action("Index", "OrderDetails")">Waiting Orders</a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered w-100" cellpadding="0" cellspacing="0">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.ID)
                    </th>
                    <th>User</th>
                    <th>Produce</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Receiver Name</th>
                    <th>Phone</th>
                    <th>City</th>
                    <th>District</th>
                    <th>Address Detail</th>
                    <th>Payment Verify</th>
                    <th>Approve</th>
                </tr>

                @foreach (var item in Model)
                {
                    <tr style="background-color:lawngreen">
                        <td>
                            @item.ID
                        </td>
                        <td>
                            @item.user.Name
                        </td>
                        <td>
                            @item.produce.Name
                        </td>
                        <td>
                            @item.Quantity
                        </td>
                        <td>
                            @item.TotalPrice
                        </td>
                        <td>
                            @item.ReceiverName
                        </td>
                        <td>
                            @item.Phone
                        </td>
                        <td>
                            @item.city.CityName
                        </td>
                        <td>
                            @item.district.DistrictName
                        </td>
                        <td>
                            @item.AddresDetail
                        </td>
                        <td>
                            <label class="bi bi-check-circle-fill text-success fs-3"></label>
                        </td>
                        <td>
                            <label class="text text-light bg-success"><i class="bi bi-check text-light"></i>  Başarıyla Onaylanmıştır</label>
                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>
    <div class="card-footer">
        <label>@Model.Count() Adet onaylanmış sipariş bulunmaktadır</label>
        <hr />
        @{
            decimal totalPrice = Model.Sum(x => x.Quantity * x.TotalPrice);
        }
         <label> Toplam @totalPrice € Kazanılmıştır.</label>
    </div>
</div>

