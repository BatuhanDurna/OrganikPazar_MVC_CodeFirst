@using OrganikPazarMVC_WebApp.Models
@model IEnumerable<CartItem>
@{
    ViewBag.Title = "Cart";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<link href="~/AssestForUser/CartCSS.css" rel="stylesheet" />

<div class="cartCarry">
    <h2>Your Cart</h2>

    @if (Model.Count() != 0)
    {
        <div class="cart">
            <table class="cartTable" cellpadding="0" cellspacing="0">
                @foreach (CartItem item in Model)
                {
                    <tr class="item">
                        <td>@item.ID</td>
                        <td>@item.Name</td>
                        <td>
                            @if (DateTime.Now.Day == 26)
                            {
                                decimal discountPrice = item.Price * 0.50m;
                                @discountPrice.ToString("F2")
                            }
                            else
                            {
                                string normalPrice = item.Price + " €";
                                @normalPrice
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("Increase", "ProduceUser", new { id = item.ID})" class="bi bi-arrow-up"></a>
                            <span class="quantity"> @item.Quantity </span>
                            <a href="@Url.Action("Decrease", "ProduceUser", new { id = item.ID})" class="bi bi-arrow-down"></a>
                        </td>
                    </tr>
                }
            </table>
        </div>
        <div class="cartSum">
            <div class="textSum">
                <h2>Total Price</h2>
            </div>
            <div class="casa">
                <div class="row">
                    <b>Total</b>
                    <div class="price">
                        @if (DateTime.Now.Day == 26)
                        {
                            <s class="fw-bold strike-thick">
                                @Model.Sum(x => (x.Price * x.Quantity)) €
                            </s>
                            <div class="text text-warning">
                                @Model.Sum(x => ((x.Price * x.Quantity) * 0.50m)).ToString("F2") €
                            </div>
                        }
                        else
                        {
                            <div class="text text-black">
                                @Model.Sum(x => (x.Price * x.Quantity)) €
                            </div>
                        }

                    </div>
                    <b>Cargo</b>
                    <div class="price">Free</div>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

                    <div class="backtoMarket mt-3">
                        <a href="@Url.Action("Index","Index")">Back to Market</a>
                    </div>

                    <div class="clearCart mt-3">
                        <a href="@Url.Action("ClearCart","ProduceUser")">Clear Cart</a>
                    </div>

                </div>
            </div>

        </div>
        <div class="container">
            <div class="row mt-3">
                <div class="col">
                    <h4>Your Address</h4>
                    <div class="col-md-5 border border-dark rounded-3 p-3 btn btn-success" type="button" data-bs-toggle="offcanvas" data-bs-target="#area">
                        + Add Address and Countinue to Payment
                    </div>

                    @if (TempData["hata"] != null)
                    {
                        <div class="text-danger fw-bold mt-2" style="font-size: 14px;">
                            <i class="bi-exclamation-triangle"></i> @TempData["hata"]
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <img src="~/AssestForUser/SepetBos.png" width="500" />
        <div class="backButton mt-2">
            <a href="@Url.Action("Index", "Index")"><span class="bi bi-bag"></span> Alışverişe Başla</a>
        </div>
    }
</div>

<div class="offcanvas offcanvas-end bg-dark" style="width:40%" id="area">
    <div class="offcanvas-header">
        <h2 class="text text-light">Add your adress</h2>
        <button class="btn-close text text-bg-light" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        @using (Html.BeginForm("AddAddress", "ProduceUser", FormMethod.Post))
        {
            
            <label class="mb-2" for="receiver" style="color:aliceblue">Receiver Name</label>
            <input type="text" name="ReceiverName" class="form-control" placeholder="Name Surname" />

            <label class="mb-2 mt-2" for="phone" style="color:aliceblue">Phone</label>
            <input type="text" name="Phone" class="form-control" placeholder="05113339988" />

            <label class="mb-2 mt-2" for="city" style="color:aliceblue">City</label>
            @Html.DropDownList("City_ID", (SelectList)ViewBag.CityID, "Select your City", htmlAttributes: new { @class = "form-select" })

            <label class="mb-2 mt-2" for="district" style="color:aliceblue">District</label>
            <select id="DistrictID" name="District_ID" class="form-select">
                <option value="">Select your District</option>
            </select>

            <label class="mb-2 mt-2" for="AddresDetail" style="color:aliceblue">Addres Detail</label>
            <textarea id="AddresDetail" name="AddresDetail" class="form-control" style="width:580px; height:145px;" placeholder="Neighborhood,Street,No etc..."></textarea>

            <button type="submit" class="btn btn-success mt-4 w-100 fw-bold">Add Address</button>


        }

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var citySelect = document.getElementById("City_ID");
        var districtSelect = document.getElementById("DistrictID");

        if (citySelect) {
            citySelect.addEventListener("change", function () {
                var selectedCityId = this.value;

                districtSelect.innerHTML = '<option value="">Select your District</option>';

                if (selectedCityId) {
                    var url = '@Url.Action("LoadDistricts", "ProduceUser")' + '?cityId=' + selectedCityId;

                    fetch(url)
                        .then(response => response.json())
                        .then(data => {
                            data.forEach(function (item) {
                                var id = item.ID !== undefined ? item.ID : item.id;
                                var name = item.DistrictName !== undefined ? item.DistrictName : item.districtName;

                                var option = document.createElement("option");
                                option.value = id;
                                option.text = name;
                                districtSelect.appendChild(option);
                            });
                        })
                        .catch(error => {
                            console.error("Hata:", error);
                            alert("İlçeler yüklenirken bir hata oluştu.");
                        });
                }
            });
        }
    });
</script>


