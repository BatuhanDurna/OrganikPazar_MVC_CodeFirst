@using OrganikPazarMVC_WebApp.Data
@model IEnumerable<ProduceUserViewModel>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<link href="~/AssestForUser/ProduceListCSS.css" rel="stylesheet" />

<div class="carouselContainer">
    <div class="container">
        <div class="carousel slide mt-3" id="change" data-bs-ride="carousel" data-bs-interval="7000">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#change" data-bs-slide-to="0" class="active"></button>
                <button type="button" data-bs-target="#change" data-bs-slide-to="1" class="active"></button>
                <button type="button" data-bs-target="#change" data-bs-slide-to="2" class="active"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/AssestForUser/carouselreklam1.jpeg" class="d-block w-100 rounded-2" />
                </div>
                <div class="carousel-item">
                    <img src="~/AssestForUser/carouselreklam2.jpeg" class="d-block w-100 rounded-2" />
                </div>
                <div class="carousel-item">
                    <img src="~/AssestForUser/carouselreklam3.jpeg" class="d-block w-100 rounded-2" />
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#change" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#change" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>
</div>

<div id="notfound" class="notfound mt-5 ms-5" hidden>
    <img src="~/AssestForUser/notfoundphoto-rembg.png" width="600"/>
    <h2 class="description">Aradığınız Kriterde Bir Ürün Bulamadık</h2>
    <a class="abutton" href="@Url.Action("Index", "Index")">Alışverişe Devam Et</a>
</div>

<div class="productContainer py-3">
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="produceItem">
                    <img src="~/Areas/ManagerPanel/Assets/ProductImage/@item.ImagePath" width="150" />
                    <div class="name text-dark">
                        @item.ProduceName
                    </div>
                    <div class="category">
                        @if (item.category != null)
                        {
                            @item.category.CategoryName
                        }
                        else
                        {
                            <span>Kategori Bulunamadı</span>
                        }
                    </div>
                    <div class="price">
                        @if (DateTime.Now.Day == 26)
                        {
                            decimal anniversaryGift = item.Price * 0.50m;
                            <s class="text text-muted">@item.Price.ToString("F2") €</s>
                            <strong class="text-danger">@anniversaryGift.ToString("F2") €</strong>
                        }
                        else
                        {
                            <span class="text-danger">@item.Price.ToString("F2") €</span>
                        }
                    </div>
                    <div class="addToCart">
                        <a href="@Url.Action("AddToCard", "ProduceUser", new { id = item.Produce_ID })">
                            <i class="bi bi-cart-plus"></i> Buy
                        </a>
                    </div>
                </div>
            </div>
            
        }
    </div>
</div>

