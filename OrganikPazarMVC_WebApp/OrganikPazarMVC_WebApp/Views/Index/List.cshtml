@model IEnumerable<OrganikPazar_Odev.Models.Produces>
@{
    ViewBag.Title = "List";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<link href="~/AssestForUser/ProduceListCSS.css" rel="stylesheet" />

<div class="productContainer">
    @foreach (var item in Model)
    {
        <div class="produceItem">
            <img src="~/Areas/ManagerPanel/Assets/ProductImage/@item.ImagePath" width="150" />
            <div class="name">
                @item.Name
            </div>
            <div class="category">
                @if (item.category != null)
                {
                    @item.category.CategoryName
                }
                else
                {
                    <span>Kategori Bulunamadı</span>
                }
            </div>
            <div class="price">
                @if (item.user != null && item.user.CreationTime.Month == DateTime.Now.Month && item.user.CreationTime.Day == DateTime.Now.Day)
                {
                    decimal anniversaryGift = item.Price * 0.50m;
                    <s class="text-muted">@item.Price.ToString("F2") €</s>
                    <strong class="text-danger">@anniversaryGift.ToString("F2") €</strong>
                }
                else
                {
                    <span class="text-danger">@item.Price.ToString("F2") €</span>
                }
            </div>
            <div class="addToCart">
                <a href="@Url.Action("AddToCard", "ProduceUser", new { id = item.ID })">
                    <i class="bi bi-cart-plus"></i> Buy
                </a>
            </div>
        </div>

    }
</div>

