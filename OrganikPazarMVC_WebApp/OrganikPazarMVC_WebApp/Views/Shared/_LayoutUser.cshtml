<!DOCTYPE html>

<html data-bs-theme="auto">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/AssestForUser/UserIndexCSS.css" rel="stylesheet" />
    <link href="~/AssestForUser/bootstrap-5.3.8/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="~/Scripts/color-modes.js"></script>
</head>
<body class="d-flex flex-column min-vh-100">
    <div class="dropdown position-fixed bottom-0 end-0 mb-3 me-3">

        <button class="btn btn-dark dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown">

            <i class="bi bi-circle-half"></i>
        </button>

        <ul class="dropdown-menu dropdown-menu-end shadow">

            <li>
                <button type="button"
                        class="dropdown-item d-flex align-items-center"
                        data-bs-theme-value="light">

                    <i class="bi bi-sun-fill me-2"></i>
                    Light
                </button>
            </li>

            <li>
                <button type="button"
                        class="dropdown-item d-flex align-items-center"
                        data-bs-theme-value="dark">

                    <i class="bi bi-moon-stars-fill me-2"></i>
                    Dark
                </button>
            </li>

            <li>
                <button type="button"
                        class="dropdown-item d-flex align-items-center active"
                        data-bs-theme-value="auto">

                    <i class="bi bi-circle-half me-2"></i>
                    Auto
                </button>
            </li>
        </ul>
    </div>
        <div class="card-header d-flex justify-content-between align-items-center bg-white sticky-top">
            <div class="card-img">
                <a href="@Url.Action("Index","Index")">
                    <img src="~/AssestForUser/OrganikUserLogo.png" width="200" />
                </a>
            </div>
            <div class="searchBar mt-4">
                <span class="bi bi-search"></span>
                <input id="filter" type="text" class="pe-5 ps-5 rounded-4" placeholder="Search" />
            </div>
            @if (Session["user"] != null)
            {
                <div class="d-flex gap-5">
                    <div>
                        <a href="@Url.Action("Cart", "ProduceUser")" class="btn btn-outline-success bi bi-cart fs-4"></a>
                    </div>
                    <div class="me-3">
                        <a href='@Url.Action("Logout", "Sign")' class="btn btn-outline-danger bi bi-box-arrow-in-right fs-4"></a>
                    </div>
                </div>
            }
            else
            {
                <div class="CardSign d-flex gap-3">
                    <a href="@Url.Action("SignIn", "Sign")" class="btn btn-warning text text-light">SignIn</a>
                    <a href="@Url.Action("SignUp", "Sign")" class="btn btn-outline-warning me-3">SignUp</a>
                </div>
            }
        </div>
    <div class="card-title menu">
        <ul>
            <li>
                @{Html.RenderAction("_CreateMenu", "CategoryUser");}
            </li>
        </ul>
    </div>
    <div class="container">
        <div class="card-body">
            @RenderBody()
        </div>
    </div>

    <div class="card-footer card-footer mt-auto" style="background-color: #fff2ea;">
        <div class="footer-stripe"></div>
        <div class="text-black d-flex mb-auto">
            © 2026 Organik Pazar - Tüm hakları saklıdır
        </div>
        <div class="bankslogo mt-3">
            <img src="~/AssestForUser/FooterBankalar.png" />
        </div>
        <div class="support ms-3 mt-3 text-dark">
            <span class="gap-3 fw-bold" style="color: #57b900;">Bize Ulaşın</span> <p>organiksupport@organikpazarlama.com</p>
        </div>
    </div>
    <script src="~/Scripts/jquery-4.0.0.min.js"></script>
    <script src="~/AssestForUser/bootstrap-5.3.8/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#filter").on("keyup", function () {
                var data = $(this).val().toLowerCase();
                if (data.trim() != "")
                {
                    $(".carouselContainer").hide();
                }
                else
                {
                    $(".carouselContainer").show();
                }

                $(".produceItem").filter(function () {
                    var productName = $(this).find(".name").text().toLowerCase();
                    $(this).toggle($(this).text().toLowerCase().indexOf(data) > -1);
                    
                    var bootstrapColumn = $(this).closest(".col-12");
                    if (productName.indexOf(data) > -1)
                    {
                        bootstrapColumn.show();
                    }
                    else
                    {
                        bootstrapColumn.hide();
                    }
                });
                var isProduceExist = $(".produceItem .name").text().toLowerCase().indexOf(data) > -1;

                if (data === "" || isProduceExist)
                {
                    $("#notfound").attr("hidden", true);
                }
                else
                {
                    $("#notfound").removeAttr("hidden");
                }
            });
        });
    </script>
</body>
</html>
